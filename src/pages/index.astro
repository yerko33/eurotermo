---
import SiteLayout from '../layouts/SiteLayout.astro';
import { business } from '../config';
---
<SiteLayout>
  <header id="top" class="sticky top-0 z-20 border-b border-ink/10 bg-paper text-ink">
    <div class="container-wide flex h-[76px] items-center justify-between">
      <a href="#top" class="flex items-center gap-3" aria-label={`${business.name}, volver al inicio`}>
        <img src="/logo-eurotermo-color.png" alt="EuroTermo Ventanas" width="220" height="59" class="h-12 w-auto max-w-[190px] object-contain object-left sm:max-w-[220px]" />
      </a>
      <nav class="hidden items-center gap-8 text-sm font-semibold text-ink/70 md:flex" aria-label="Navegación principal">
        <a class="hover:text-orange" href="#productos">Ventanas</a><a class="hover:text-orange" href="#servicios">Servicios</a><a class="hover:text-orange" href="#proyectos">Proyectos</a><a class="hover:text-orange" href="#preguntas">FAQ</a>
      </nav>
      <a href="#configurador" class="hidden rounded-sm bg-moss px-5 py-3 text-sm font-bold text-white transition hover:bg-ink sm:inline-flex">Cotizar proyecto <span class="ml-2">↗</span></a>
      <button data-menu-button aria-expanded="false" aria-label="Abrir menú" class="grid size-10 place-items-center rounded-sm border border-ink/20 text-xl md:hidden">☰</button>
    </div>
    <nav data-mobile-menu class="container-wide hidden border-t border-ink/10 py-4 text-ink md:hidden" aria-label="Navegación móvil">
      <div class="flex flex-col gap-4 text-sm font-semibold"><a href="#productos">Ventanas</a><a href="#servicios">Servicios</a><a href="#proyectos">Proyectos</a><a href="#preguntas">Preguntas frecuentes</a><a class="text-moss" href="#configurador">Configurar y cotizar ↗</a></div>
    </nav>
  </header>

  <main>
    <section class="hero-section relative isolate overflow-hidden bg-ink text-white">
      <div class="hero-blueprint absolute inset-0"></div>
      <div class="container-wide relative grid min-h-[690px] items-center gap-10 py-14 lg:grid-cols-[.88fr_1.12fr] lg:py-20">
        <div class="hero-copy relative z-10 max-w-[600px]">
          <p class="eyebrow mb-6 flex items-center gap-3 text-sage"><span class="h-[2px] w-8 bg-orange"></span> Fabricación · Venta · Instalación</p>
          <h1 class="font-display text-[clamp(4.5rem,8vw,7.5rem)] font-semibold leading-[.86] tracking-[-.025em]">Hechas para<br /><span class="hero-accent text-orange">encajar.</span></h1>
          <p class="mt-8 max-w-[430px] text-base leading-7 text-white/75 sm:text-lg">Fabricamos ventanas a medida para tu obra o remodelación. Configura tu idea y cotiza directo con el taller.</p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#configurador" class="button-primary group inline-flex items-center rounded-sm bg-orange px-6 py-4 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-white hover:text-ink">Configurar y cotizar <span class="button-arrow ml-3">↗</span></a>
            <a href="#productos" class="inline-flex items-center gap-2 px-2 py-3 text-sm font-semibold text-white/80 transition hover:text-white">Conocer ventanas <span class="button-arrow text-orange">↓</span></a>
          </div>
          <div class="mt-12 grid max-w-[510px] grid-cols-3 border-t border-white/20 pt-5 text-xs font-semibold uppercase tracking-wider text-white/65">
            <span><b class="mr-2 font-display text-2xl text-orange">01</b><br class="sm:hidden" />Diseñamos</span><span><b class="mr-2 font-display text-2xl text-orange">02</b><br class="sm:hidden" />Fabricamos</span><span><b class="mr-2 font-display text-2xl text-orange">03</b><br class="sm:hidden" />Instalamos</span>
          </div>
        </div>
        <div class="hero-visual relative mx-auto w-full max-w-[700px] py-5">
          <div class="hero-photo-frame relative p-2 sm:p-3">
            <div class="hero-photo relative min-h-[370px] overflow-hidden sm:min-h-[510px]">
              <img src="https://images.pexels.com/photos/13597045/pexels-photo-13597045.jpeg?auto=compress&cs=tinysrgb&w=1800" alt="Ventanal de gran formato integrado en un espacio residencial" fetchpriority="high" class="hero-image absolute inset-0 h-full w-full object-cover" />
              <div class="hero-image-shade absolute inset-0"></div>
              <div class="absolute left-4 top-4 flex items-center gap-2 bg-paper px-3 py-2 text-[10px] font-bold uppercase tracking-[.14em] text-ink sm:left-6 sm:top-6"><span class="size-2 rounded-full bg-moss"></span> Imagen referencial · Ventanas a medida</div>
              <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4 text-white sm:bottom-8 sm:left-8 sm:right-8">
                <div><span class="eyebrow text-sage">EuroTermo · Soluciones a medida</span><p class="mt-2 max-w-sm font-display text-3xl font-semibold leading-tight sm:text-4xl">Más luz. Más confort. A tu medida.</p></div>
                <a href="#configurador" aria-label="Configurar una ventana" class="grid size-12 shrink-0 place-items-center rounded-full bg-orange text-xl text-white transition hover:scale-110 hover:bg-white hover:text-ink">↘</a>
              </div>
            </div>
          </div>
          <div class="hero-caption mt-3 flex items-center justify-between text-[10px] font-semibold uppercase tracking-[.2em] text-white/55"><span>Fabricación a medida</span><span>Diseño · Producción · Montaje</span></div>
        </div>
      </div>
    </section>

    <section id="configurador" class="scroll-mt-10 border-y border-moss/10 bg-[#e7efe7] py-20 text-ink md:py-24">
      <div class="container-wide">
        <div class="section-heading mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal><div><p class="eyebrow mb-4 text-moss">Cotizador a medida · 01</p><h2 class="font-display text-5xl font-semibold tracking-tight md:text-6xl">Partamos por las medidas.</h2></div><p class="max-w-md text-sm leading-6 text-ink/60">Arma una referencia para tu proyecto. Revisaremos contigo materiales, medidas e instalación antes de cotizar.</p></div>
        <div class="overflow-hidden border-t-4 border-orange bg-paper lg:grid lg:grid-cols-[1.08fr_.92fr]">
          <div class="bg-sage/30 p-6 sm:p-10">
            <div class="mb-6 flex items-center justify-between"><span class="eyebrow text-moss">Vista previa</span><span class="border border-ink/10 bg-paper px-3 py-1.5 text-xs font-semibold text-ink/60">Modelo referencial</span></div>
            <div class="relative flex min-h-[300px] items-center justify-center overflow-hidden border border-ink/10 bg-paper sm:min-h-[360px]">
              <div class="technical-paper-grid absolute inset-0"></div>
              <svg class="relative z-10 h-auto w-[88%] max-w-[490px] drop-shadow-xl" viewBox="0 0 480 330" role="img" aria-label="Vista previa dinámica de la ventana configurada">
                <defs>
                  <linearGradient id="preview-glass" x1="0" y1="0" x2="1" y2="1"><stop data-glass-tone offset="0" stop-color="#e1f0ec"/><stop offset="1" stop-color="#9dbbb4"/></linearGradient>
                  <pattern id="glass-lines" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M0 5 5 0" stroke="#fff" stroke-opacity=".5" stroke-width="1"/></pattern>
                </defs>
                <path d="M28 299h424" stroke="#53675a" stroke-width="3" stroke-linecap="round"/>
                <g class="window-shape" data-window-shape transform="translate(240 165) scale(0.82 0.82) translate(-240 -165)">
                  <rect data-frame data-frame-fill x="65" y="48" width="350" height="234" fill="#fff" stroke="#914621" stroke-width="16" />
                  <rect data-glass-pane x="78" y="61" width="324" height="208" fill="url(#preview-glass)" />
                  <path data-glass-reflection d="M90 72h128l-55 178H90z" fill="#fff" opacity=".24" />
                  <rect data-glass-lines x="78" y="61" width="324" height="208" fill="url(#glass-lines)" opacity="0" />
                  <g data-sash-for="Corredera">
                    <path data-frame d="M240 57v216M70 165h340" fill="none" stroke="#fff" stroke-width="7" />
                    <path d="M230 151l-9 14 9 14m20-28 9 14-9 14" fill="none" stroke="#08613b" stroke-width="3" />
                  </g>
                  <g data-sash-for="Abatible" style="display:none">
                    <rect data-frame x="80" y="63" width="320" height="204" fill="none" stroke="#fff" stroke-width="7" />
                    <path d="M94 250 386 79" fill="none" stroke="#08613b" stroke-width="4" stroke-dasharray="7 6" />
                    <circle cx="386" cy="79" r="5" fill="#914621" />
                  </g>
                  <g data-sash-for="Proyectante" style="display:none">
                    <path data-frame d="M80 67h320M80 262h320M90 75l280 102" fill="none" stroke="#fff" stroke-width="7" />
                    <path d="M95 245 368 150" fill="none" stroke="#08613b" stroke-width="4" stroke-dasharray="7 6" />
                  </g>
                  <g data-sash-for="Fija" style="display:none">
                    <rect data-frame x="80" y="63" width="320" height="204" fill="none" stroke="#fff" stroke-width="7" />
                  </g>
                  <g data-sash-for="Puerta ventana" style="display:none">
                    <path data-frame d="M240 57v216M70 263h340" fill="none" stroke="#fff" stroke-width="7" />
                    <path d="M230 142l-9 14 9 14m20-28 9 14-9 14" fill="none" stroke="#08613b" stroke-width="3" />
                    <circle cx="222" cy="205" r="4" fill="#914621" />
                  </g>
                </g>
              </svg>
              <span class="absolute bottom-4 left-4 border-l-2 border-orange bg-paper/95 px-3 py-2 text-xs font-bold text-ink"><span data-type-label>Corredera</span> · <span data-width-label>150 cm</span> × <span data-height-label>120 cm</span> · <span data-preview-glass>Termopanel</span></span>
            </div>
            <div class="mt-5 flex items-center justify-between gap-3 text-sm"><span class="font-semibold">Vista aproximada del modelo</span><span class="text-right text-ink/50">La apariencia final puede variar</span></div>
          </div>
          <div class="border-t border-moss/15 p-6 sm:p-10 lg:border-l lg:border-t-0">
            <form data-quote-form class="space-y-6">
              <div><p class="eyebrow text-moss">Ficha inicial / 01</p><h3 class="mt-2 font-display text-3xl font-semibold">Configura tu ventana</h3><p class="mt-1 text-sm text-ink/55">Cuéntanos lo esencial para preparar la cotización.</p></div>
              <div class="space-y-5">
                <label for="window-width" class="block text-sm font-semibold">Ancho <span class="font-normal text-ink/45">(cm)</span><output data-width-value for="window-width" class="float-right rounded-sm bg-sage px-2 py-1 text-xs font-bold text-moss">150 cm</output><input id="window-width" name="width" type="range" min="60" max="300" step="5" value="150" required class="range-control mt-3 block" aria-label="Ancho de la ventana en centímetros" /></label>
                <label for="window-height" class="block text-sm font-semibold">Alto <span class="font-normal text-ink/45">(cm)</span><output data-height-value for="window-height" class="float-right rounded-sm bg-sage px-2 py-1 text-xs font-bold text-moss">120 cm</output><input id="window-height" name="height" type="range" min="60" max="240" step="5" value="120" required class="range-control mt-3 block" aria-label="Alto de la ventana en centímetros" /></label>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="text-sm font-semibold">Tipo de ventana<select id="window-type" name="windowType" class="quote-field mt-2 w-full border border-ink/15 bg-paper px-4 py-3"><option>Corredera</option><option>Abatible</option><option>Proyectante</option><option>Fija</option><option>Puerta ventana</option></select></label>
                <label class="text-sm font-semibold">Color del marco<select id="window-finish" name="finish" class="quote-field mt-2 w-full border border-ink/15 bg-paper px-4 py-3"><option>Blanco</option><option>Grafito</option><option>Negro</option></select></label>
              </div>
              <label class="block text-sm font-semibold">Tipo de vidrio<select id="window-glass" name="glass" class="quote-field mt-2 w-full border border-ink/15 bg-paper px-4 py-3"><option>Termopanel</option><option>Vidrio simple</option><option>Vidrio laminado</option></select></label>
              <div class="border-l-4 border-orange bg-sage/55 p-4"><span class="eyebrow text-moss">Resumen del requerimiento</span><p data-config-summary class="mt-1 text-sm font-semibold">Corredera · 150 × 120 cm · Blanco · Termopanel</p></div>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="text-sm font-semibold">Tu nombre<input name="name" autocomplete="name" required placeholder="Nombre y apellido" class="quote-field mt-2 w-full border border-ink/15 bg-paper px-4 py-3" /></label>
                <label class="text-sm font-semibold">Teléfono<input name="phone" type="tel" autocomplete="tel" required placeholder="+56 9 1234 5678" class="quote-field mt-2 w-full border border-ink/15 bg-paper px-4 py-3" /></label>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="text-sm font-semibold">Comuna<input name="commune" autocomplete="address-level2" required placeholder="¿Dónde instalamos?" class="quote-field mt-2 w-full border border-ink/15 bg-paper px-4 py-3" /></label>
                <label class="text-sm font-semibold">Comentario <span class="font-normal text-ink/45">(opcional)</span><input name="notes" placeholder="Cantidad, instalación…" class="quote-field mt-2 w-full border border-ink/15 bg-paper px-4 py-3" /></label>
              </div>
              <button type="submit" class="w-full rounded-sm bg-moss px-6 py-4 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-ink">Enviar ficha al taller por WhatsApp <span class="ml-2 text-sage">↗</span></button>
              <p data-form-status role="status" aria-live="polite" class="text-center text-xs leading-5 text-ink/50">La cotización final se confirma al revisar medidas, materiales e instalación.</p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section id="productos" class="scroll-mt-10 bg-moss py-20 text-white md:py-24">
      <div class="container-wide">
      <div class="section-heading flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal><div><p class="eyebrow mb-4 text-sage">Catálogo · 02</p><h2 class="font-display text-5xl font-semibold tracking-tight md:text-6xl">Elige el sistema.</h2></div><p class="max-w-sm text-sm leading-6 text-white/75">Distintas aperturas y soluciones de vidrio para obra nueva, ampliación y recambio.</p></div>
      <div class="mt-10 grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        <article class="group border-t-2 border-orange pt-3"><div class="relative aspect-[4/3] overflow-hidden bg-sand"><span class="absolute left-3 top-3 z-10 bg-orange px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-white">01 / Corredera</span><img src="https://images.pexels.com/photos/5691476/pexels-photo-5691476.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Ventana de marco oscuro en un espacio interior" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" /></div><h3 class="mt-4 font-display text-2xl font-semibold">Correderas</h3><p class="mt-1 max-w-[28ch] text-sm leading-6 text-white/75">Deslizamiento lateral para aprovechar el espacio disponible.</p></article>
        <article class="group border-t-2 border-orange pt-3"><div class="relative aspect-[4/3] overflow-hidden bg-sand"><span class="absolute left-3 top-3 z-10 bg-orange px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-white">02 / Abatible</span><img src="https://images.pexels.com/photos/8987429/pexels-photo-8987429.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Ventana abatible en una vivienda contemporánea" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" /></div><h3 class="mt-4 font-display text-2xl font-semibold">Abatibles</h3><p class="mt-1 max-w-[28ch] text-sm leading-6 text-white/75">Apertura amplia para ventilar y facilitar la limpieza.</p></article>
        <article class="group border-t-2 border-orange pt-3"><div class="relative aspect-[4/3] overflow-hidden bg-sand"><span class="absolute left-3 top-3 z-10 bg-orange px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-white">03 / Proyectante</span><img src="https://images.pexels.com/photos/18426836/pexels-photo-18426836.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Paños de vidrio y marcos en una arquitectura moderna" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" /></div><h3 class="mt-4 font-display text-2xl font-semibold">Proyectantes</h3><p class="mt-1 max-w-[28ch] text-sm leading-6 text-white/75">Ventilación controlada para distintos recintos.</p></article>
        <article class="group border-t-2 border-orange pt-3"><div class="relative aspect-[4/3] overflow-hidden bg-sand"><span class="absolute left-3 top-3 z-10 bg-orange px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-white">04 / Paño fijo</span><img src="https://images.pexels.com/photos/13597045/pexels-photo-13597045.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Ventanal fijo con vista a un jardín" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" /></div><h3 class="mt-4 font-display text-2xl font-semibold">Paños fijos</h3><p class="mt-1 max-w-[28ch] text-sm leading-6 text-white/75">Superficies vidriadas para sumar luz y abrir las vistas.</p></article>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-white/20 pt-5 text-sm text-white/80"><span><b class="text-orange">También:</b> puertas ventana · termopanel · recambio a medida</span><a href="#configurador" class="font-bold uppercase tracking-wide text-white hover:text-orange">Cotizar una solución ↗</a></div>
      <p class="mt-3 text-xs text-white/55">Fotografías ilustrativas de <a href="https://www.pexels.com/" target="_blank" rel="noreferrer" class="underline underline-offset-2">Pexels</a>; no son imágenes de catálogo EuroTermo.</p>
      </div>
    </section>

    <section id="servicios" class="scroll-mt-10 border-y border-orange/15 bg-[#f3e9e2] py-20 md:py-24">
      <div class="container-wide grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
        <div data-reveal><p class="eyebrow mb-4 text-moss">El trabajo completo / 03</p><h2 class="font-display text-5xl font-semibold tracking-tight md:text-6xl">Del taller<br />a tu obra.</h2><p class="mt-5 max-w-md leading-7 text-ink/65">Un solo equipo para definir la solución, fabricar a medida y dejarla instalada.</p><a href="#configurador" class="mt-7 inline-flex rounded-sm bg-moss px-5 py-3 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-ink">Pedir cotización ↗</a></div>
        <div class="divide-y divide-moss/20 border-y border-moss/20" data-reveal-group>
          <article class="grid gap-2 py-5 sm:grid-cols-[100px_1fr]"><span class="eyebrow text-orange">01 / Asesoría</span><div><h3 class="font-display text-2xl font-bold uppercase">Definición del proyecto</h3><p class="mt-1 text-sm leading-6 text-ink/70">Revisamos medidas, tipo de apertura y terminación que necesitas.</p></div></article>
          <article class="grid gap-2 py-5 sm:grid-cols-[100px_1fr]"><span class="eyebrow text-orange">02 / Fabricación</span><div><h3 class="font-display text-2xl font-bold uppercase">Producción a medida</h3><p class="mt-1 text-sm leading-6 text-ink/70">Fabricamos ventanas según las especificaciones acordadas.</p></div></article>
          <article class="grid gap-2 py-5 sm:grid-cols-[100px_1fr]"><span class="eyebrow text-orange">03 / Instalación</span><div><h3 class="font-display text-2xl font-bold uppercase">Montaje y terminación</h3><p class="mt-1 text-sm leading-6 text-ink/70">Coordinamos la instalación en obra o el recambio de ventanas existentes.</p></div></article>
        </div>
      </div>
    </section>

    <section id="proceso" class="container-wide scroll-mt-10 py-20 md:py-24">
      <div class="mx-auto max-w-3xl text-center" data-reveal><p class="eyebrow mb-4 text-moss">Simple y directo</p><h2 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">Cotiza en tres pasos.</h2><p class="mx-auto mt-4 max-w-xl text-ink/55">Partimos con tu configuración y confirmamos cada detalle contigo.</p></div>
      <div class="mt-12 grid gap-8 md:grid-cols-3" data-reveal-group>
        <div class="border-t-2 border-moss pt-5"><span class="font-display text-4xl font-semibold text-moss/40">01</span><h3 class="mt-3 font-display text-xl font-bold">Configura</h3><p class="mt-2 text-sm leading-6 text-ink/55">Elige medidas aproximadas, apertura, color y vidrio.</p></div>
        <div class="border-t-2 border-ink/15 pt-5"><span class="font-display text-4xl font-semibold text-ink/25">02</span><h3 class="mt-3 font-display text-xl font-bold">Envíanos tu solicitud</h3><p class="mt-2 text-sm leading-6 text-ink/55">Déjanos tus datos y la comuna donde necesitas el servicio.</p></div>
        <div class="border-t-2 border-ink/15 pt-5"><span class="font-display text-4xl font-semibold text-ink/25">03</span><h3 class="mt-3 font-display text-xl font-bold">Revisamos contigo</h3><p class="mt-2 text-sm leading-6 text-ink/55">Te contactamos para validar medidas, alcance y cotización.</p></div>
      </div>
    </section>

    <section id="proyectos" class="scroll-mt-10 bg-ink py-20 text-white md:py-24">
      <div class="container-wide">
        <div class="mb-9 flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal>
          <div><p class="eyebrow mb-4 text-orange">Galería · 04</p><h2 class="font-display text-5xl font-semibold tracking-tight md:text-6xl">Ventanas en contexto.</h2></div>
          <p class="max-w-md text-sm leading-6 text-white/60">Ideas de espacios y terminaciones para imaginar tu próximo proyecto. Las fotografías son referenciales; esta galería se puede sustituir por obras reales de EuroTermo.</p>
        </div>
        <div class="grid gap-4 md:grid-cols-3" data-reveal-group>
          <figure class="group relative min-h-[340px] overflow-hidden border border-white/15 md:col-span-2">
            <img src="https://images.pexels.com/photos/13597045/pexels-photo-13597045.jpeg?auto=compress&cs=tinysrgb&w=1600" alt="Espacio residencial iluminado por una ventana de gran formato" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-ink/15"></div><span class="absolute left-4 top-4 bg-paper px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-ink">Imagen referencial</span>
            <figcaption class="absolute bottom-5 left-5"><span class="eyebrow text-sage">Luz y amplitud</span><h3 class="mt-1 font-display text-3xl font-bold uppercase">Ventanal residencial</h3></figcaption>
          </figure>
          <figure class="group relative min-h-[340px] overflow-hidden border border-white/15">
